---
---

<aside class="sidebar" id="sidebar">
  <div class="sidebar-header">
    <button class="sidebar-toggle-icon-btn" id="sidebarToggle" title="Buka / Tutup Sidebar">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
        <path d="M9 3v18"></path>
      </svg>
    </button>
  </div>

  <div class="sidebar-new-chat">
    <button class="new-session-btn" id="newSessionBtn" title="Chat Baru">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      <span class="new-chat-text">New chat</span>
    </button>
  </div>

  <div class="session-list-container">
    <div class="session-list" id="sessionList">
      <div class="session-loading">Memuat...</div>
    </div>
  </div>

</aside>

<!-- Modal Memori Personal -->
<div class="modal-backdrop" id="memoryModalBackdrop" style="display: none;">
  <div class="memory-modal">
    <div class="memory-modal-header">
      <h3>Ingatan Personal (Atomic Facts)</h3>
      <button class="modal-close-btn" id="closeMemoryModalBtn">&times;</button>
    </div>
    <div class="memory-modal-body" id="memoryListContainer">
      <div class="session-loading">Memuat ingatan...</div>
    </div>
  </div>
</div>

<!-- Modal Autentikasi Bergaya Hirael Login 03 -->
<div class="modal-backdrop" id="authModalBackdrop" style="display: none;">
  <div class="memory-modal auth-dialog-card hirael-login-card">
    <!-- Floating Paths SVG Animation Background -->
    <div class="hirael-floating-paths" aria-hidden="true">
      <svg class="hirael-paths-svg" fill="none" viewBox="0 0 600 450">
        <path class="hirael-path hp-1" d="M-120 -60 C-60 140, 110 210, 310 180 C510 150, 640 340, 720 460" stroke="currentColor" stroke-width="1.2" />
        <path class="hirael-path hp-2" d="M-90 -40 C-30 160, 140 230, 340 200 C540 170, 670 360, 750 480" stroke="currentColor" stroke-width="1.4" />
        <path class="hirael-path hp-3" d="M-60 -20 C0 180, 170 250, 370 220 C570 190, 700 380, 780 500" stroke="currentColor" stroke-width="1.6" />
        <path class="hirael-path hp-4" d="M-30 0 C30 200, 200 270, 400 240 C600 210, 730 400, 810 520" stroke="currentColor" stroke-width="1.8" />
        <path class="hirael-path hp-5" d="M0 20 C60 220, 230 290, 430 260 C630 230, 760 420, 840 540" stroke="currentColor" stroke-width="2.0" />
        <path class="hirael-path hp-6" d="M30 40 C90 240, 260 310, 460 280 C660 250, 790 440, 870 560" stroke="currentColor" stroke-width="2.2" />
      </svg>
    </div>

    <!-- Ambient Radial Glow -->
    <div class="hirael-ambient-glow glow-top" aria-hidden="true"></div>
    <div class="hirael-ambient-glow glow-bottom" aria-hidden="true"></div>

    <button class="modal-close-btn auth-close-floating" id="closeAuthModalBtn" title="Tutup">&times;</button>
    <div class="auth-dialog-header">
      <div class="hirael-brand-mark">
        <svg viewBox="0 0 32 32" fill="none" class="hirael-brand-svg" width="20" height="20">
          <rect width="32" height="32" rx="8" fill="#1c1917"/>
          <path d="M10 7C10 14.5 9.5 19.5 12 22.5C14 25 18 25.5 21 23C23.5 21 24 17.5 21.5 15C19 12.5 15.5 14 13.5 17.5C11.5 21 10 24 7.5 25.5" stroke="#fafaf9" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="21.5" cy="8.5" r="1.75" fill="#f59e0b"/>
        </svg>
        <span class="hirael-brand-text">Luwesin</span>
      </div>
      <h3 id="authModalTitle" class="auth-dialog-title">Selamat Datang</h3>
      <p id="authModalSubtitle" class="auth-dialog-subtitle">Masuk untuk melanjutkan percakapan & fitur pintar</p>
    </div>
    <div class="auth-dialog-body" id="authModalBody">
      <div id="authViewContainer">
        <!-- Form Auth Dinamis -->
      </div>
    </div>
  </div>
</div>

<script>
  import {
    listSessions,
    renameSession,
    deleteSession,
    getMemories,
    deleteMemory,
    registerUser,
    verifyOtp,
    loginUser,
    getGoogleLoginUrl,
    getCurrentUser,
    getAuthToken,
    setAuthToken,
  } from '../lib/api';

  const sessionListEl = document.getElementById('sessionList');
  const newBtn = document.getElementById('newSessionBtn');
  const toggleBtn = document.getElementById('sidebarToggle');
  const openMemoryBtn = document.getElementById('openMemoryModalBtn');
  const closeMemoryBtn = document.getElementById('closeMemoryModalBtn');
  const memoryBackdrop = document.getElementById('memoryModalBackdrop');
  const memoryListEl = document.getElementById('memoryListContainer');

  const openAuthBtn = document.getElementById('openAuthModalBtn');
  const closeAuthBtn = document.getElementById('closeAuthModalBtn');
  const authBackdrop = document.getElementById('memoryModalBackdrop');
  const authViewContainer = document.getElementById('authViewContainer');
  const userAccountLabel = document.getElementById('userAccountLabel');

  const appContainer = document.querySelector('.app-container');
  if (localStorage.getItem('sidebarCollapsed') === 'true') {
    appContainer?.classList.add('sidebar-collapsed');
  }

  toggleBtn?.addEventListener('click', () => {
    appContainer?.classList.toggle('sidebar-collapsed');
    const isCollapsed = appContainer?.classList.contains('sidebar-collapsed');
    localStorage.setItem('sidebarCollapsed', String(!!isCollapsed));
  });

  // Handle Google OAuth callback URL token
  const urlParams = new URLSearchParams(window.location.search);
  const tokenParam = urlParams.get('token');
  if (tokenParam) {
    setAuthToken(tokenParam);
    window.history.replaceState({}, document.title, window.location.pathname);
  }

  const authModalEl = document.getElementById('authModalBackdrop');

  async function checkUserSession() {
    const closeBtnEl = document.getElementById('closeAuthModalBtn');
    const labelEl = document.getElementById('userAccountLabel');

    if (getAuthToken()) {
      try {
        const user = await getCurrentUser();
        if (labelEl && user.email) {
          labelEl.textContent = user.name || user.email;
        }
        if (closeBtnEl) closeBtnEl.style.display = 'inline-flex';
        window.dispatchEvent(new CustomEvent('auth:change', { detail: { isAuthenticated: true, user } }));
        return;
      } catch {
        setAuthToken('');
      }
    }

    // User is NOT logged in
    if (labelEl) labelEl.textContent = 'Masuk / Daftar';
    if (closeBtnEl) closeBtnEl.style.display = 'inline-flex';
    window.dispatchEvent(new CustomEvent('auth:change', { detail: { isAuthenticated: false } }));
  }

  // Open Memory Modal from header button dynamically (requires auth)
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const memBtn = target.closest('#openMemoryModalBtn');
    if (memBtn) {
      if (!getAuthToken()) {
        if (authModalEl) authModalEl.style.display = 'flex';
        renderAuthForm('login');
        return;
      }
      if (memoryBackdrop) memoryBackdrop.style.display = 'flex';
      await loadMemories();
    }
  });

  closeMemoryBtn?.addEventListener('click', () => {
    if (memoryBackdrop) memoryBackdrop.style.display = 'none';
  });

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const authBtn = target.closest('#openAuthModalBtn');
    if (authBtn) {
      if (authModalEl) authModalEl.style.display = 'flex';
      renderAuthForm('login');
    }
  });

  closeAuthBtn?.addEventListener('click', () => {
    if (authModalEl) authModalEl.style.display = 'none';
  });

  authModalEl?.addEventListener('click', (e) => {
    if (e.target === authModalEl) {
      authModalEl.style.display = 'none';
    }
  });

  async function renderAuthForm(mode: 'login' | 'register' | 'otp', emailForOtp = '') {
    if (!authViewContainer) return;
    if (getAuthToken()) {
      try {
        const user = await getCurrentUser();
        const initial = (user.name || user.email || 'U').charAt(0).toUpperCase();
        authViewContainer.innerHTML = `
          <div style="text-align: center; padding: 1.25rem 0.5rem;">
            <div style="width: 56px; height: 56px; border-radius: 50%; background: linear-gradient(135deg, #38bdf8, #818cf8); color: #09090b; font-size: 1.5rem; font-weight: 700; display: flex; align-items: center; justify-content: center; margin: 0 auto 0.85rem auto; box-shadow: 0 8px 20px rgba(56, 189, 248, 0.3);">
              ${initial}
            </div>
            <h4 style="margin: 0 0 0.25rem 0; color: #f4f4f5; font-size: 1.1rem; font-weight: 600;">${user.name || 'Pengguna'}</h4>
            <p style="margin: 0 0 0.85rem 0; color: #a1a1aa; font-size: 0.85rem;">${user.email}</p>
            <div style="margin-bottom: 1.5rem;">
              <span class="memory-badge" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); padding: 0.3rem 0.75rem; border-radius: 9999px;">
                Metode: ${user.auth_provider === 'google' ? 'Google OAuth2' : 'Email OTP'}
              </span>
            </div>
            <div>
              <button id="logoutBtn" style="width: 100%; padding: 0.7rem; border-radius: 10px; background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); font-weight: 600; cursor: pointer; transition: all 0.2s ease;">
                Keluar (Logout)
              </button>
            </div>
          </div>
        `;
        document.getElementById('logoutBtn')?.addEventListener('click', () => {
          setAuthToken('');
          localStorage.removeItem('currentSessionId');
          checkUserSession();
          if (authModalEl) authModalEl.style.display = 'none';
          refreshSessions();
          window.dispatchEvent(new CustomEvent('auth:logout'));
        });
        return;
      } catch {
        setAuthToken('');
      }
    }

    if (mode === 'login') {
      const modalTitle = document.getElementById('authModalTitle');
      const modalSubtitle = document.getElementById('authModalSubtitle');
      if (modalTitle) modalTitle.textContent = 'Selamat Datang';
      if (modalSubtitle) modalSubtitle.textContent = 'Masuk untuk melanjutkan percakapan & fitur pintar';

      authViewContainer.innerHTML = `
        <button type="button" id="googleLoginBtn" class="google-sso-btn">
          <svg width="18" height="18" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
          <span>Lanjutkan dengan Google</span>
        </button>

        <div class="auth-divider">
          <span>atau dengan email</span>
        </div>

        <form id="authLoginForm" class="auth-form-stack">
          <div class="auth-input-group">
            <span class="auth-field-icon">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </span>
            <input type="email" id="loginEmail" placeholder="nama@email.com" class="auth-input-field has-icon" required autocomplete="email" />
          </div>

          <div class="auth-input-group">
            <span class="auth-field-icon">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </span>
            <input type="password" id="loginPassword" placeholder="Kata Sandi Akun" class="auth-input-field has-icon" required autocomplete="current-password" />
          </div>

          <button type="submit" class="auth-primary-btn" id="loginSubmitBtn">
            <span>Masuk ke Akun</span>
          </button>
        </form>

        <div class="auth-bottom-switch">
          <span>Belum memiliki akun?</span>
          <button type="button" class="auth-link-btn" id="switchRegisterBtn">Daftar sekarang</button>
        </div>

        <p class="auth-terms-note">
          Dengan melanjutkan, Anda menyetujui <a href="#">Ketentuan Layanan</a> & <a href="#">Kebijakan Privasi</a>.
        </p>
      `;

      document.getElementById('switchRegisterBtn')?.addEventListener('click', () => renderAuthForm('register'));
      document.getElementById('authLoginForm')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = (document.getElementById('loginEmail') as HTMLInputElement).value;
        const password = (document.getElementById('loginPassword') as HTMLInputElement).value;
        try {
          await loginUser(email, password);
          await checkUserSession();
          if (authModalEl) authModalEl.style.display = 'none';
          refreshSessions();
          window.dispatchEvent(new CustomEvent('auth:login'));
        } catch (err: any) {
          alert(err.message || 'Gagal masuk');
        }
      });

      document.getElementById('googleLoginBtn')?.addEventListener('click', async () => {
        try {
          const res = await getGoogleLoginUrl();
          if (res.url) window.location.href = res.url;
        } catch (err: any) {
          alert('OAuth Google belum dikonfigurasi.');
        }
      });
    } else if (mode === 'register') {
      const modalTitle = document.getElementById('authModalTitle');
      const modalSubtitle = document.getElementById('authModalSubtitle');
      if (modalTitle) modalTitle.textContent = 'Buat Akun Baru';
      if (modalSubtitle) modalSubtitle.textContent = 'Mulai obrolan AI & simpan riwayat serta ingatan personal Anda';

      authViewContainer.innerHTML = `
        <button type="button" id="googleLoginBtnReg" class="google-sso-btn">
          <svg width="18" height="18" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
          <span>Daftar dengan Google</span>
        </button>

        <div class="auth-divider">
          <span>atau daftar dengan email</span>
        </div>

        <form id="authRegisterForm" class="auth-form-stack">
          <div class="auth-input-group">
            <span class="auth-field-icon">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </span>
            <input type="text" id="regName" placeholder="Nama Lengkap" class="auth-input-field has-icon" required autocomplete="name" />
          </div>

          <div class="auth-input-group">
            <span class="auth-field-icon">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </span>
            <input type="email" id="regEmail" placeholder="nama@email.com" class="auth-input-field has-icon" required autocomplete="email" />
          </div>

          <div class="auth-input-group">
            <span class="auth-field-icon">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </span>
            <input type="password" id="regPassword" placeholder="Kata Sandi (Min 6 Karakter)" class="auth-input-field has-icon" required minlength="6" autocomplete="new-password" />
          </div>

          <button type="submit" class="auth-primary-btn" id="regSubmitBtn">
            <span>Daftar & Kirim Kode OTP</span>
          </button>
        </form>

        <div class="auth-bottom-switch">
          <span>Sudah memiliki akun?</span>
          <button type="button" class="auth-link-btn" id="switchLoginBtn">Masuk di sini</button>
        </div>
      `;

      document.getElementById('switchLoginBtn')?.addEventListener('click', () => renderAuthForm('login'));
      document.getElementById('authRegisterForm')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = (document.getElementById('regName') as HTMLInputElement).value;
        const email = (document.getElementById('regEmail') as HTMLInputElement).value;
        const password = (document.getElementById('regPassword') as HTMLInputElement).value;
        try {
          const res = await registerUser(name, email, password);
          alert(res.message || 'Kode OTP verifikasi dikirim ke email');
          renderAuthForm('otp', email);
        } catch (err: any) {
          alert(err.message || 'Gagal mendaftar');
        }
      });

      document.getElementById('googleLoginBtnReg')?.addEventListener('click', async () => {
        try {
          const res = await getGoogleLoginUrl();
          if (res.url) window.location.href = res.url;
        } catch (err: any) {
          alert('OAuth Google belum dikonfigurasi.');
        }
      });
    } else if (mode === 'otp') {
      const modalTitle = document.getElementById('authModalTitle');
      const modalSubtitle = document.getElementById('authModalSubtitle');
      if (modalTitle) modalTitle.textContent = 'Verifikasi Kode OTP';
      if (modalSubtitle) modalSubtitle.textContent = `Kode verifikasi telah dikirim ke ${emailForOtp}`;

      authViewContainer.innerHTML = `
        <form id="authOtpForm" class="auth-form-stack" style="text-align: center;">
          <div class="otp-instruction-badge">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <p class="otp-sub-text">Silakan periksa kotak masuk atau spam email Anda.</p>
          <input type="text" id="otpCode" placeholder="••••••" maxlength="6" class="auth-input-field otp-input-field" required autofocus />
          <button type="submit" class="auth-primary-btn">Verifikasi Kode & Masuk</button>
          <div class="auth-bottom-switch" style="justify-content: center;">
            <button type="button" class="auth-link-btn" id="backToLoginBtn">← Kembali ke Halaman Masuk</button>
          </div>
        </form>
      `;

      document.getElementById('backToLoginBtn')?.addEventListener('click', () => renderAuthForm('login'));
      document.getElementById('authOtpForm')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const otp = (document.getElementById('otpCode') as HTMLInputElement).value;
        try {
          await verifyOtp(emailForOtp, otp);
          alert('Verifikasi berhasil!');
          await checkUserSession();
          if (authModalEl) authModalEl.style.display = 'none';
          refreshSessions();
          window.dispatchEvent(new CustomEvent('auth:login'));
        } catch (err: any) {
          alert(err.message || 'Gagal verifikasi OTP');
        }
      });
    }
  }

  async function loadMemories() {
    if (!memoryListEl) return;
    if (!getAuthToken()) {
      memoryListEl.innerHTML = `<div class="session-empty">Masuk untuk melihat ingatan personal</div>`;
      return;
    }
    try {
      const memories = await getMemories();
      if (!memories || memories.length === 0) {
        memoryListEl.innerHTML = `<div class="session-empty">Belum ada ingatan personal tersimpan. AI akan mengekstrak fakta penting dari obrolan Anda secara otomatis.</div>`;
        return;
      }
      memoryListEl.innerHTML = memories.map((m: any) => `
        <div class="memory-item">
          <div class="memory-meta">
            <span class="memory-badge">${escapeHtml(m.category)}</span>
            <span class="memory-fact">${escapeHtml(m.fact)}</span>
          </div>
          <button class="action-btn btn-delete-memory" data-id="${m.id}" title="Hapus Ingatan">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          </button>
        </div>
      `).join('');

      memoryListEl.querySelectorAll('.btn-delete-memory').forEach((btn: any) => {
        btn.addEventListener('click', async () => {
          const id = btn.dataset.id;
          if (id && confirm('Hapus fakta ingatan ini?')) {
            await deleteMemory(id);
            await loadMemories();
          }
        });
      });
    } catch {
      memoryListEl.innerHTML = `<div class="session-empty">Gagal memuat ingatan</div>`;
    }
  }

  let currentActiveId = localStorage.getItem('currentSessionId') || '';

  async function refreshSessions(activeId?: string) {
    if (activeId !== undefined) currentActiveId = activeId;
    if (!getAuthToken()) {
      if (sessionListEl) sessionListEl.innerHTML = `<div class="session-empty">Masuk untuk melihat riwayat chat</div>`;
      return;
    }
    try {
      const sessions = await listSessions();
      renderSessions(sessions);
    } catch {
      if (sessionListEl) sessionListEl.innerHTML = `<div class="session-empty">Belum ada chat</div>`;
    }
  }

  function renderSessions(sessions: any[]) {
    if (!sessionListEl) return;
    if (!sessions || sessions.length === 0) {
      sessionListEl.innerHTML = `<div class="session-empty">Belum ada chat</div>`;
      return;
    }

    sessionListEl.innerHTML = sessions.map((s: any) => `
      <div class="session-item ${s.id === currentActiveId ? 'active' : ''}" data-id="${s.id}">
        <button class="session-title-btn" data-id="${s.id}" title="${escapeAttr(s.title || 'Sesi Baru')}">
          <span class="truncate">${escapeHtml(s.title || 'Sesi Baru')}</span>
        </button>
        <div class="session-item-actions">
          <button class="action-btn btn-rename" data-id="${s.id}" data-title="${escapeAttr(s.title || '')}" title="Ubah Nama">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          </button>
          <button class="action-btn btn-delete" data-id="${s.id}" title="Hapus">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          </button>
        </div>
      </div>
    `).join('');
  }

  function escapeHtml(str: string) {
    return String(str).replace(/[&<>"']/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[m as keyof typeof map]));
  }
  const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
  function escapeAttr(str: string) {
    return String(str).replace(/"/g, '&quot;');
  }

  function handleNewSession() {
    if (!getAuthToken()) {
      if (authModalEl) authModalEl.style.display = 'flex';
      renderAuthForm('login');
      return;
    }
    currentActiveId = 'draft-' + Math.random().toString(36).substring(2, 15);
    localStorage.setItem('currentSessionId', currentActiveId);
    window.dispatchEvent(new CustomEvent('session:change', { detail: { sessionId: currentActiveId } }));
    refreshSessions(currentActiveId);
  }

  newBtn?.addEventListener('click', handleNewSession);

  sessionListEl?.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const renameBtn = target.closest('.btn-rename') as HTMLElement;
    const deleteBtn = target.closest('.btn-delete') as HTMLElement;
    const selectBtn = target.closest('.session-title-btn') as HTMLElement || target.closest('.session-item') as HTMLElement;

    if (renameBtn) {
      e.stopPropagation();
      const id = renameBtn.dataset.id!;
      const oldTitle = renameBtn.dataset.title || '';
      const newTitle = prompt('Ubah judul sesi:', oldTitle);
      if (newTitle !== null && newTitle.trim() !== '') {
        await renameSession(id, newTitle.trim());
        await refreshSessions();
      }
      return;
    }

    if (deleteBtn) {
      e.stopPropagation();
      const id = deleteBtn.dataset.id!;
      if (confirm('Hapus percakapan ini?')) {
        await deleteSession(id);
        if (currentActiveId === id) {
          const sessions = await listSessions();
          currentActiveId = sessions[0]?.id || ('draft-' + Math.random().toString(36).substring(2, 15));
          localStorage.setItem('currentSessionId', currentActiveId);
          window.dispatchEvent(new CustomEvent('session:change', { detail: { sessionId: currentActiveId } }));
        }
        await refreshSessions();
      }
      return;
    }

    if (selectBtn) {
      const id = selectBtn.dataset.id;
      if (id && id !== currentActiveId) {
        currentActiveId = id;
        localStorage.setItem('currentSessionId', currentActiveId);
        window.dispatchEvent(new CustomEvent('session:change', { detail: { sessionId: currentActiveId } }));
        renderActiveState();
      }
    }
  });

  function renderActiveState() {
    document.querySelectorAll('.session-item').forEach(el => {
      el.classList.toggle('active', (el as HTMLElement).dataset.id === currentActiveId);
    });
  }

  window.addEventListener('session:change', (e: any) => {
    currentActiveId = e.detail.sessionId;
    renderActiveState();
  });

  window.addEventListener('session:refresh', async (e: any) => {
    if (e.detail && e.detail.sessionId) {
      currentActiveId = e.detail.sessionId;
    }
    await refreshSessions(currentActiveId);
  });

  checkUserSession();
  refreshSessions();
</script>
