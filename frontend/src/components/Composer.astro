---
---

<div class="composer-container">
  <!-- RAG Toggle Pill - Centered Above Card -->
  <div class="rag-toggle-bar">
    <div class="rag-pill-group" id="ragToggleGroup">
      <button type="button" id="ragOff" class="rag-pill">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        <span>Quick Chat</span>
      </button>
      <button type="button" id="ragOn" class="rag-pill active">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        <span>Read & Analyze</span>
      </button>
    </div>
  </div>

  <!-- Composer Card -->
  <div class="composer-card">
    <div class="composer-input-row">
      <textarea id="inputText" placeholder="Ketik pertanyaan..." rows="1"></textarea>
    </div>

    <div class="composer-actions">
      <div class="actions-left">
        <label class="upload-btn" title="Unggah PDF">
          <input type="file" id="docInput" accept=".pdf" hidden />
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
          </svg>
          <span id="uploadLabelText">PDF</span>
        </label>
      </div>

      <div class="actions-right">
        <button class="send-button" id="sendBtn" aria-label="Kirim" disabled>
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 2L11 13"></path>
            <path d="M22 2L15 22L11 13L2 9L22 2Z"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
  <div class="disclaimer">AI dapat membuat kesalahan.</div>
</div>
