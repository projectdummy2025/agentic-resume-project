---
const suggestions = [
  { icon: 'sparkles', label: 'Apa itu Machine Learning & cara kerjanya?', text: 'Apa itu Machine Learning dan bagaimana cara kerjanya?' },
  { icon: 'code', label: 'REST API vs GraphQL', text: 'Jelaskan perbedaan antara REST API dan GraphQL.' },
  { icon: 'compass', label: 'Rekomendasi Pemrograman Web', text: 'Berikan rekomendasi langkah belajar pemrograman Web.' },
  { icon: 'file-text', label: 'Analisis Dokumen PDF', text: 'Jelaskan ringkasan dokumen yang sudah diunggah.' }
];

const promptModes = [
  { id: 'zero-shot', label: 'Zero-Shot', iconType: 'zap' },
  { id: 'few-shot', label: 'Few-Shot', iconType: 'target' },
  { id: 'cot', label: 'CoT Reasoning', iconType: 'cpu' }
];
---

<main id="mainContent">
  <div class="chat-wrapper" id="chatWrapper">
    <div class="empty-state" id="emptyState">
      <h1 class="hero-title">Apa yang ingin Anda tanyakan hari ini?</h1>

      <div class="suggestion-grid" id="suggestionGrid">
        {suggestions.map((s) => (
          <button class="suggestion-pill" data-suggestion={s.text}>
            {s.icon === 'sparkles' && (
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l1.912 5.813a2 2 0 001.275 1.275L21 12l-5.813 1.912a2 2 0 00-1.275 1.275L12 21l-1.912-5.813a2 2 0 00-1.275-1.275L3 12l5.813-1.912a2 2 0 001.275-1.275L12 3z"/></svg>
            )}
            {s.icon === 'code' && (
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            )}
            {s.icon === 'compass' && (
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
            )}
            {s.icon === 'file-text' && (
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            )}
            <span>{s.label}</span>
          </button>
        ))}
      </div>
    </div>
  </div>
</main>

<div class="footer-container" id="footerContainer">
  <div class="composer-card">
    <textarea id="inputText" placeholder="Ketik pertanyaan atau minta analisis dokumen..." rows="2"></textarea>

    <div class="composer-actions">
      <div class="actions-left">
        <label class="upload-btn" title="Unggah PDF ke basis pengetahuan">
          <input type="file" id="docInput" accept=".pdf" hidden />
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
          </svg>
          <span id="uploadLabelText">Lampirkan PDF</span>
        </label>
      </div>

      <div class="actions-right">
        <div class="mode-dropdown-wrapper">
          <button type="button" class="mode-select-btn" id="modeSelectBtn" title="Pilih Mode Prompting">
            <span class="mode-icon-svg" id="currentModeIcon">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            </span>
            <span id="currentModeLabel">Zero-Shot</span>
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="mode-menu" id="modeMenu">
            {promptModes.map((m, i) => (
              <button class={`mode-menu-item${i === 0 ? ' active' : ''}`} data-style={m.id} data-label={m.label} data-icontype={m.iconType}>
                <span class="item-icon-svg">
                  {m.iconType === 'zap' && <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>}
                  {m.iconType === 'target' && <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>}
                  {m.iconType === 'cpu' && <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="15" x2="23" y2="15"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="15" x2="4" y2="15"/></svg>}
                </span>
                <span>{m.label}</span>
              </button>
            ))}
          </div>
        </div>

        <button class="send-button" id="sendBtn" aria-label="Kirim Pesan" disabled>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="19" x2="12" y2="5"></line>
            <polyline points="5 12 12 5 19 12"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="disclaimer">
    Hasil generate memungkinkan halusinasi dan kesalahan.
  </div>
</div>
