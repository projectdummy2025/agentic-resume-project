---
const styles = ['zero-shot', 'few-shot', 'cot'];
const labels = { 'zero-shot': 'Zero-Shot', 'few-shot': 'Few-Shot', 'cot': 'CoT' };
---

<header>
  <div class="header-brand">Universal Chatbot</div>
  <div class="prompt-tabs" id="promptTabs">
    {styles.map((s, i) => (
      <button class={`tab-btn${i === 0 ? ' active' : ''}`} data-style={s}>{labels[s]}</button>
    ))}
  </div>
  <label class="upload-btn" title="Unggah PDF ke basis pengetahuan">
    <input type="file" id="docInput" accept=".pdf" hidden>
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
    <span>Unggah</span>
  </label>
</header>
