---
---

<header class="top-header">
  <div class="header-brand">
    <img src="/favicon.svg" alt="Luwesin Logo" width="22" height="22" style="border-radius: 6px;" />
    <span>Luwesin</span>
  </div>

  <div class="header-right">
    <button class="header-memory-btn" id="openMemoryModalBtn" title="Ingatan Personal (MAG)">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M12 16v-4"></path>
        <path d="M12 8h.01"></path>
      </svg>
      <span>Ingatan Saya</span>
    </button>

    <button class="header-auth-btn" id="openAuthModalBtn" title="Akun & Autentikasi">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
      <span id="userAccountLabel">Masuk / Daftar</span>
    </button>
  </div>
</header>
