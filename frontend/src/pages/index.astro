---
import '../styles/global.css';
import ChatHeader from '../components/ChatHeader.astro';
import Composer from '../components/Composer.astro';
import Sidebar from '../components/Sidebar.astro';

const suggestions = [
  { icon: 'sparkles', label: 'Apa itu Machine Learning?', text: 'Apa itu Machine Learning dan bagaimana cara kerjanya?' },
  { icon: 'code', label: 'REST API vs GraphQL', text: 'Jelaskan perbedaan antara REST API dan GraphQL.' },
  { icon: 'compass', label: 'Belajar Pemrograman Web', text: 'Berikan rekomendasi langkah belajar pemrograman Web.' },
  { icon: 'file-text', label: 'Analisis Dokumen PDF', text: 'Jelaskan ringkasan dokumen PDF yang sudah diunggah.' }
];
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Universal AI Assistant</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>
  <div class="app-container">
    <Sidebar />

    <div class="main-section">
      <ChatHeader />

      <main id="mainContent" class="main-content">
        <div class="empty-state" id="emptyState">
          <div class="hero-icon">
            <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M12 3l1.912 5.813a2 2 0 001.275 1.275L21 12l-5.813 1.912a2 2 0 00-1.275 1.275L12 21l-1.912-5.813a2 2 0 00-1.275-1.275L3 12l5.813-1.912a2 2 0 001.275-1.275L12 3z"/>
            </svg>
          </div>
          <h1 class="hero-title">Apa yang ingin Anda pelajari hari ini?</h1>
          <p class="hero-subtitle">Mulai obrolan langsung atau lampirkan dokumen PDF kapan saja untuk dianalisis.</p>

          <div class="suggestion-grid" id="suggestionGrid">
            {suggestions.map((s) => (
              <button class="suggestion-pill" data-suggestion={s.text}>
                <span class="pill-icon">
                  {s.icon === 'sparkles' && <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l1.912 5.813a2 2 0 001.275 1.275L21 12l-5.813 1.912a2 2 0 00-1.275 1.275L12 21l-1.912-5.813a2 2 0 00-1.275-1.275L3 12l5.813-1.912a2 2 0 001.275-1.275L12 3z"/></svg>}
                  {s.icon === 'code' && <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>}
                  {s.icon === 'compass' && <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>}
                  {s.icon === 'file-text' && <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>}
                </span>
                <span>{s.label}</span>
              </button>
            ))}
          </div>
        </div>

        <div class="chat-wrapper" id="chatWrapper"></div>
      </main>

      <Composer />
    </div>
  </div>

  <script>
    import { createSession, getMessages, chatStream, ingestPdf } from '../lib/api';
    import { renderResult, renderMarkdown, escapeHtml } from '../lib/format';

    let currentPromptStyle = 'zero-shot';
    let isChatLocked = false;
    let currentSessionId = localStorage.getItem('currentSessionId') || '';

    const $ = (id: string) => document.getElementById(id)!;
    const inputEl = () => $('inputText') as HTMLTextAreaElement;
    const sendBtn = () => $('sendBtn') as HTMLButtonElement;

    function lockTabs() {
      if (isChatLocked) return;
      isChatLocked = true;
    }

    function autoResize(el: HTMLTextAreaElement) {
      el.style.height = 'auto';
      el.style.height = Math.min(el.scrollHeight, 180) + 'px';
      sendBtn().disabled = !el.value.trim() || isChatLocked;
    }

    function scrollToBottom() {
      const main = $('mainContent');
      if (main) main.scrollTop = main.scrollHeight;
    }

    function hideIntro() {
      const empty = $('emptyState');
      if (empty) empty.style.display = 'none';
    }

    function showIntro() {
      const empty = $('emptyState');
      if (empty) empty.style.display = 'flex';
    }

    function updateDocBadges(documents: string[] = []) {
      const bar = $('docBadgesBar');
      const list = $('docBadgeList');
      if (!bar || !list) return;

      if (!documents || documents.length === 0) {
        bar.style.display = 'none';
        list.innerHTML = '';
        return;
      }

      // Extract unique clean document filenames (strip page tags if present)
      const cleanDocs = Array.from(new Set(documents.map(d => d.replace(/\s*\(hal\.\s*\d+\)$/i, '').trim()))).filter(Boolean);

      if (cleanDocs.length === 0) {
        bar.style.display = 'none';
        list.innerHTML = '';
        return;
      }

      bar.style.display = 'block';
      list.innerHTML = cleanDocs.map(doc => `
        <span class="doc-badge-item" title="${escapeHtml(doc)}">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          <span>${escapeHtml(doc)}</span>
        </span>
      `).join('');
    }

    function addUserRow(text: string) {
      const row = document.createElement('div');
      row.className = 'message-row user';
      row.innerHTML = `<div class="user-bubble">${escapeHtml(text)}</div>`;
      $('chatWrapper').appendChild(row);
    }

    function addSystemEventRow(text: string) {
      const row = document.createElement('div');
      row.className = 'message-row system-event';
      row.style.cssText = 'display: flex; justify-content: center; margin: 0.75rem 0; font-size: 0.8rem; color: #94a3b8;';
      row.innerHTML = `<div style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 9999px; padding: 0.25rem 0.75rem; display: inline-flex; align-items: center; gap: 0.35rem;">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/></svg>
        <span>${escapeHtml(text)}</span>
      </div>`;
      $('chatWrapper').appendChild(row);
      scrollToBottom();
    }

    function addBotRow(): HTMLElement {
      const row = document.createElement('div');
      row.className = 'message-row bot';
      row.innerHTML = `<div class="bot-content"><div class="typing-indicator"><span></span><span></span><span></span></div></div>`;
      $('chatWrapper').appendChild(row);
      return row.querySelector('.bot-content') as HTMLElement;
    }

    async function sendMessage() {
      const text = inputEl().value.trim();
      if (!text || isChatLocked) return;

      hideIntro();
      lockTabs();
      addUserRow(text);
      const botContent = addBotRow();

      inputEl().value = '';
      inputEl().style.height = 'auto';
      sendBtn().disabled = true;
      scrollToBottom();

      // Persist draft session on backend before sending message if ID is a draft
      if (!currentSessionId || currentSessionId.startsWith('draft-')) {
        try {
          const targetId = currentSessionId || ('draft-' + Math.random().toString(36).substring(2, 15));
          const cleanId = targetId.replace('draft-', '');

          await createSession(cleanId, text);
          currentSessionId = cleanId;
          localStorage.setItem('currentSessionId', currentSessionId);
          window.dispatchEvent(new CustomEvent('session:refresh', { detail: { sessionId: currentSessionId } }));
        } catch (err) {
          botContent.innerHTML = `<span style="color: #f87171;">Error: ${escapeHtml((err as Error).message)}</span>`;
          isChatLocked = false;
          sendBtn().disabled = false;
          return;
        }
      }

      let streamedText = '';
      let activeDocuments: string[] = [];

      try {
        await chatStream(
          text,
          currentPromptStyle,
          currentSessionId,
          (chunk) => {
            streamedText += chunk;
            botContent.innerHTML = renderMarkdown(streamedText);
            scrollToBottom();
          },
          (docs) => {
            activeDocuments = docs;
            updateDocBadges(docs);
          },
          (fullText) => {
            let resultObj: any = { jawaban: fullText || streamedText };
            if (activeDocuments && activeDocuments.length > 0) {
              const cleanActive = Array.from(new Set(activeDocuments.map(d => d.replace(/\s*\(hal\.\s*\d+\)$/i, '').trim()))).filter(Boolean);
              resultObj.dokumen = cleanActive;
            }
            botContent.innerHTML = renderResult(resultObj);
            window.dispatchEvent(new CustomEvent('session:refresh', { detail: { sessionId: currentSessionId } }));
          },
          (err) => {
            botContent.innerHTML = `<span style="color: #f87171;">Error: ${escapeHtml(err.message)}</span>`;
          }
        );
      } catch (err) {
        botContent.innerHTML = `<span style="color: #f87171;">Error: ${escapeHtml((err as Error).message)}</span>`;
      } finally {
        isChatLocked = false;
        sendBtn().disabled = false;
        scrollToBottom();
      }
    }

    async function loadHistory(sessionId: string) {
      const chatWrapper = $('chatWrapper');

      if (!sessionId || sessionId.startsWith('draft-')) {
        chatWrapper.innerHTML = '';
        updateDocBadges([]);
        showIntro();
        return;
      }

      try {
        const data = await getMessages(sessionId);
        chatWrapper.innerHTML = '';
        updateDocBadges(data.documents || []);

        if (!data.messages || data.messages.length === 0) {
          showIntro();
          return;
        }

        hideIntro();

        const cleanDocs = Array.from(new Set((data.documents || []).map(d => d.replace(/\s*\(hal\.\s*\d+\)$/i, '').trim()))).filter(Boolean);

        for (const msg of data.messages) {
          if (msg.role === 'user') {
            addUserRow(msg.content);
          } else {
            const botContent = addBotRow();
            botContent.innerHTML = renderResult({
              jawaban: msg.content,
              dokumen: cleanDocs.length > 0 ? cleanDocs : undefined
            });
          }
        }
        scrollToBottom();
      } catch (err) {
        // If session ID was deleted or missing from backend, gracefully reset to a new draft session
        currentSessionId = 'draft-' + Math.random().toString(36).substring(2, 15);
        localStorage.setItem('currentSessionId', currentSessionId);
        chatWrapper.innerHTML = '';
        updateDocBadges([]);
        showIntro();
      }
    }

    async function initSession() {
      if (currentSessionId && !currentSessionId.startsWith('draft-')) {
        const res = await getMessages(currentSessionId).catch(() => null);
        if (res) {
          await loadHistory(currentSessionId);
          return;
        } else {
          currentSessionId = '';
        }
      }

      if (!currentSessionId) {
        currentSessionId = 'draft-' + Math.random().toString(36).substring(2, 15);
        localStorage.setItem('currentSessionId', currentSessionId);
      }
      window.dispatchEvent(new CustomEvent('session:change', { detail: { sessionId: currentSessionId } }));
    }

    async function uploadDoc(input: HTMLInputElement) {
      const file = input.files?.[0];
      if (!file) return;

      const labelText = $('uploadLabelText');
      const prevText = labelText ? labelText.textContent : 'Lampirkan PDF';
      if (labelText) labelText.textContent = 'Mengunggah…';

      // Persist draft session on backend before uploading PDF
      if (!currentSessionId || currentSessionId.startsWith('draft-')) {
        try {
          const targetId = currentSessionId || ('draft-' + Math.random().toString(36).substring(2, 15));
          const cleanId = targetId.replace('draft-', '');

          await createSession(cleanId, file.name);
          currentSessionId = cleanId;
          localStorage.setItem('currentSessionId', currentSessionId);
          window.dispatchEvent(new CustomEvent('session:refresh', { detail: { sessionId: currentSessionId } }));
        } catch (err) {
          if (labelText) labelText.textContent = 'Gagal';
          alert('Gagal membuat sesi: ' + (err as Error).message);
          return;
        }
      }

      try {
        const res = await ingestPdf(file, currentSessionId);
        if (labelText) labelText.textContent = `✓ ${file.name}`;

        hideIntro();
        addSystemEventRow(`Dokumen "${file.name}" berhasil ditambahkan (${res.chunks} chunks).`);
        updateDocBadges(res.documents || [file.name]);

        window.dispatchEvent(new CustomEvent('session:refresh'));
      } catch (err) {
        if (labelText) labelText.textContent = 'Gagal';
        alert((err as Error).message);
      } finally {
        setTimeout(() => { if (labelText && prevText) labelText.textContent = prevText; }, 3000);
        input.value = '';
      }
    }

    function init() {
      document.querySelectorAll('.suggestion-pill').forEach((card) => {
        card.addEventListener('click', () => {
          inputEl().value = (card as HTMLElement).dataset.suggestion!;
          autoResize(inputEl());
          sendMessage();
        });
      });

      inputEl().addEventListener('input', () => autoResize(inputEl()));
      inputEl().addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
      });
      sendBtn().addEventListener('click', sendMessage);
      $('docInput').addEventListener('change', (e) => uploadDoc(e.target as HTMLInputElement));

      window.addEventListener('session:change', async (e: any) => {
        currentSessionId = e.detail.sessionId;
        localStorage.setItem('currentSessionId', currentSessionId);
        await loadHistory(currentSessionId);
      });

      initSession();
    }

    init();
  </script>
</body>
</html>
